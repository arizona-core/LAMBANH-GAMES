    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "0.35.5",
    "supabase": "2.118.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
